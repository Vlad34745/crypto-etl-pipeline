# Copy this file to .env and edit values as needed.
# .env is git-ignored and never committed.

# Comma-separated CoinGecko coin IDs to track
COIN_IDS=bitcoin,ethereum,solana,near,the-open-network

# CoinGecko markets endpoint (rarely needs to change)
API_URL=https://api.coingecko.com/api/v3/coins/markets

# API retry behavior
RETRIES=3
RETRY_DELAY_SECONDS=15

# Output storage
OUTPUT_FILE=crypto_history.xlsx
BACKUP_DIR=backups
MAX_BACKUPS=10

# Logging
LOG_FILE=pipeline.log
LOG_LEVEL=INFO
