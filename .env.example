# Copy this file to .env and edit values as needed.
# .env is git-ignored and never committed.

# Comma-separated CoinGecko coin IDs to track (NOT tickers — use the
# CoinGecko "id", which is usually the lowercase full name).
# Default is Bitcoin only. To add more, copy IDs from the list below
# and separate them with commas, e.g.:
#   COIN_IDS=bitcoin,ethereum,solana
#
# Common coin IDs (ticker -> id), for easy copy-paste:
#   BTC  -> bitcoin
#   ETH  -> ethereum
#   SOL  -> solana
#   NEAR -> near
#   TON  -> the-open-network
#   ADA  -> cardano
#   XRP  -> ripple
#   DOGE -> dogecoin
#   DOT  -> polkadot
#   AVAX -> avalanche-2
#   LINK -> chainlink
#   LTC  -> litecoin
#   MATIC/POL -> matic-network
#   BNB  -> binancecoin
# Full searchable list: https://api.coingecko.com/api/v3/coins/list
COIN_IDS=btc-bitcoin,eth-ethereum,sol-solana

# CoinGecko markets endpoint (rarely needs to change)
API_URL=https://api.coinpaprika.com/v1/tickers

# API retry behavior
RETRIES=3
RETRY_DELAY_SECONDS=15

# Storage — DB_FILE is the source of truth; OUTPUT_FILE (Excel) is
# regenerated from it on every run, so it's safe to delete anytime.
DB_FILE=crypto_history.db
OUTPUT_FILE=crypto_history.xlsx
BACKUP_DIR=backups
MAX_BACKUPS=10

# Skip writing a new snapshot if the last one is more recent than this many
# minutes (0 = always write, no throttling). Useful if you run the pipeline
# often (e.g. every few minutes) but only want a snapshot every hour.
MIN_SNAPSHOT_INTERVAL_MINUTES=0

# --- Telegram alerts (optional) ---------------------------------------------
# Leave both blank to disable. To enable: message @BotFather on Telegram to
# create a bot and get a token, then message your bot once and check
# https://api.telegram.org/bot<TOKEN>/getUpdates to find your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Send an alert when a coin's 24h change is at or above this percent (abs value)
ALERT_THRESHOLD_PERCENT=5.0

# Logging
LOG_FILE=pipeline.log
LOG_LEVEL=INFO
